{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidgen.dev/schemas/assembly-template.schema.json",
  "title": "AssemblyTemplate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "output", "contentSlots", "generatedAssetRoles", "standardizedAssetRoles", "segments"],
  "properties": {
    "schemaVersion": { "const": "2" },
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "version": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "container", "videoCodec"],
      "properties": {
        "width": { "const": 1080 },
        "height": { "const": 1920 },
        "fps": { "const": 30 },
        "container": { "const": "mp4" },
        "videoCodec": { "const": "h264" }
      }
    },
    "contentSlots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/contentSlot" } },
    "generatedAssetRoles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/generatedAssetRole" } },
    "standardizedAssetRoles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/standardizedAssetRole" } },
    "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/segment" } }
  },
  "$defs": {
    "contentSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "usage", "instruction"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "usage": { "enum": ["spoken", "display"] },
        "instruction": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "generatedAssetRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "kind": { "enum": ["presenter", "video", "voiceover"] }
      }
    },
    "standardizedAssetRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "placement"],
      "properties": {
        "id": { "enum": ["intro", "outro"] },
        "placement": { "enum": ["before-story", "after-story"] }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "startSeconds", "endSeconds", "contentSlots", "generatedAssetRoles"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "startSeconds": { "type": "number" },
        "endSeconds": { "type": "number" },
        "contentSlots": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
        "generatedAssetRoles": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } }
      }
    }
  }
}
