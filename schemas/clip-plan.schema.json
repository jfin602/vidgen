{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidgen.dev/schemas/clip-plan.schema.json",
  "title": "ClipPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyFingerprint", "template", "slots"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "storyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "version": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slot" }
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" }
      }
    }
  }
}
