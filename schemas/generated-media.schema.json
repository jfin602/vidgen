{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vidgen.dev/schemas/generated-media.schema.json",
  "title": "Generated media manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "storyRunId", "storyFingerprint", "clipPlanFingerprint", "template", "referenceImages", "assets"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "storyRunId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "storyFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "clipPlanFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "template": { "$ref": "#/$defs/template" },
    "referenceImages": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "assets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } }
  },
  "$defs": {
    "template": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } } },
    "reference": { "type": "object", "additionalProperties": false, "required": ["ordinal", "basename", "mimeType", "sha256", "byteSize"], "properties": { "ordinal": { "type": "integer", "minimum": 1 }, "basename": { "type": "string", "minLength": 1 }, "mimeType": { "type": "string", "enum": ["image/png", "image/jpeg", "image/webp"] }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "byteSize": { "type": "integer", "minimum": 1 } } },
    "asset": { "type": "object", "additionalProperties": false, "required": ["unitId", "segment", "role", "effectiveGenerationInputFingerprint", "status", "assetPath", "sha256", "byteSize", "mimeType", "provider", "configuredModel", "returnedModel"], "properties": { "unitId": { "type": "string", "pattern": "^u[0-9]+$" }, "segment": { "type": "object", "additionalProperties": false, "required": ["id", "startSeconds", "endSeconds"], "properties": { "id": { "type": "string" }, "startSeconds": { "type": "number" }, "endSeconds": { "type": "number" } } }, "role": { "type": "object", "additionalProperties": false, "required": ["id", "kind"], "properties": { "id": { "type": "string" }, "kind": { "enum": ["presenter", "video", "voiceover"] } } }, "effectiveGenerationInputFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "status": { "const": "ready" }, "provenance": { "enum": ["generated", "reused"] }, "assetPath": { "type": "string", "pattern": "^(assets/(presenter|video)/u[0-9]+\\.mp4|assets/audio/u[0-9]+\\.wav)$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "byteSize": { "type": "integer", "minimum": 1 }, "mimeType": { "type": "string", "enum": ["video/mp4", "audio/wav"] }, "provider": { "type": "string", "minLength": 1 }, "configuredModel": { "type": "string", "minLength": 1 }, "returnedModel": { "type": "string", "minLength": 1 }, "voice": { "type": "string", "minLength": 1 }, "requestId": { "type": "string", "minLength": 1 }, "operationId": { "type": "string", "minLength": 1 }, "operationIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "generationOperationCount": { "type": "integer", "minimum": 1 }, "durationSeconds": { "type": "number", "exclusiveMinimum": 0 } } }
  }
}
